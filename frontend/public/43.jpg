<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_43" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#500724" />
      <stop offset="100%" stop-color="#fb7185" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_43" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_43)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#fb7185" opacity="0.18" filter="url(#glow_43)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="121.0" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="60.5" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">Medium Support</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#fb7185" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">apparel top</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- Apparel Top Graphic -->
        <g transform="translate(65, 42) scale(1.1)">
            <path d="M55 25 L85 40 L115 25 L145 45 L130 75 L115 65 L115 140 L55 140 L55 65 L40 75 L25 45 Z" fill="#fb7185" fill-opacity="0.3"/>
            <path d="M58 30 L85 43 L112 30 L138 48 L126 70 L112 62 L112 135 L58 135 L58 62 L44 70 L32 48 Z" fill="#fb7185"/>
            <path d="M68 30 Q85 45 102 30" fill="none" stroke="#ffffff" stroke-width="3"/>
            <line x1="85" y1="55" x2="85" y2="125" stroke="#ffffff" stroke-width="2" stroke-opacity="0.4" stroke-dasharray="4 4"/>
            <circle cx="85" cy="85" r="8" fill="#ffffff" fill-opacity="0.2"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#fb7185" fill-opacity="0.4" />
</svg>
