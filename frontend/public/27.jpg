<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_27" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#082f49" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_27" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_27)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#0284c7" opacity="0.18" filter="url(#glow_27)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="121.0" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="60.5" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">500ml Handheld</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#0284c7" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">hydration</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- Hydration Flask Graphic -->
        <g transform="translate(90, 35) scale(1.2)">
            <rect x="35" y="15" width="20" height="12" rx="3" fill="#ffffff" fill-opacity="0.9"/>
            <path d="M25 35 C20 45 20 120 25 140 C28 150 62 150 65 140 C70 120 70 45 65 35 Z" fill="#0284c7" fill-opacity="0.3"/>
            <path d="M28 40 C24 50 24 115 28 135 C30 142 60 142 62 135 C66 115 66 50 62 40 Z" fill="#0284c7"/>
            <path d="M32 60 Q45 65 58 60 M32 85 Q45 90 58 85 M32 110 Q45 115 58 110" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-opacity="0.6"/>
            <ellipse cx="45" cy="120" rx="8" ry="12" fill="#ffffff" fill-opacity="0.2"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#0284c7" fill-opacity="0.4" />
</svg>
