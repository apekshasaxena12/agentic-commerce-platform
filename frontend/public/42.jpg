<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_42" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b0764" />
      <stop offset="100%" stop-color="#c084fc" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_42" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_42)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#c084fc" opacity="0.18" filter="url(#glow_42)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="143.5" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="71.75" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">High-Waist Pocket</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#c084fc" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">apparel bottom</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- Apparel Bottom Graphic -->
        <g transform="translate(70, 42) scale(1.1)">
            <path d="M40 25 L120 25 L125 70 L100 140 L78 140 L80 75 L70 75 L72 140 L50 140 L25 70 Z" fill="#c084fc" fill-opacity="0.3"/>
            <path d="M44 30 L116 30 L120 68 L96 132 L80 132 L82 72 L68 72 L70 132 L54 132 L30 68 Z" fill="#c084fc"/>
            <line x1="44" y1="40" x2="116" y2="40" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
            <path d="M68 72 L82 72" stroke="#ffffff" stroke-width="2"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#c084fc" fill-opacity="0.4" />
</svg>
