<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_49" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#020617" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_49" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_49)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#6366f1" opacity="0.18" filter="url(#glow_49)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="128.5" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="64.25" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">Dual-GPS 14-Day</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#6366f1" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">wearable tech</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- GPS Running Watch Graphic -->
        <g transform="translate(85, 35) scale(1.15)">
            <rect x="42" y="10" width="36" height="40" rx="6" fill="#334155"/>
            <rect x="42" y="125" width="36" height="40" rx="6" fill="#334155"/>
            <rect x="25" y="42" width="70" height="85" rx="18" fill="#1e293b" stroke="#6366f1" stroke-width="3"/>
            <rect x="32" y="49" width="56" height="71" rx="12" fill="#0f172a"/>
            <text x="60" y="75" fill="#6366f1" font-family="system-ui, sans-serif" font-size="14" font-weight="700" text-anchor="middle">05:24</text>
            <text x="60" y="92" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="9" font-weight="600" text-anchor="middle">♥ 148 bpm</text>
            <text x="60" y="106" fill="#ffffff" font-family="system-ui, sans-serif" font-size="8" font-weight="500" text-anchor="middle" fill-opacity="0.8">5.20 km</text>
            <circle cx="85" cy="84" r="3" fill="#6366f1"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#6366f1" fill-opacity="0.4" />
</svg>
