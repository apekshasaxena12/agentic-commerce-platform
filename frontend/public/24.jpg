<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_24" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_24" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_24)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#38bdf8" opacity="0.18" filter="url(#glow_24)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="83.5" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="41.75" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">Quick-Dry</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#38bdf8" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">accessories</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- Accessories Graphic -->
        <g transform="translate(65, 45) scale(1.15)">
            <path d="M30 85 C30 50 60 40 95 40 C130 40 145 60 150 85 L15 85 Z" fill="#38bdf8" fill-opacity="0.3"/>
            <path d="M35 80 C35 52 62 45 92 45 C122 45 136 62 140 80 L25 80 Z" fill="#38bdf8"/>
            <path d="M25 80 C40 80 80 82 120 75 C145 70 160 75 165 82 C168 86 160 90 140 90 C95 90 40 88 20 85 Z" fill="#ffffff" fill-opacity="0.85"/>
            <circle cx="92" cy="45" r="4" fill="#ffffff"/>
            <path d="M92 49 Q92 68 85 80" stroke="#ffffff" stroke-width="2" fill="none" stroke-opacity="0.6"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#38bdf8" fill-opacity="0.4" />
</svg>
