<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_44" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#134e4a" />
      <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0.3" />
    </linearGradient>
    <filter id="glow_44" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="300" height="240" rx="16" fill="url(#grad_44)" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="300" y2="60" />
    <line x1="0" y1="120" x2="300" y2="120" />
    <line x1="0" y1="180" x2="300" y2="180" />
    <line x1="75" y1="0" x2="75" y2="240" />
    <line x1="150" y1="0" x2="150" y2="240" />
    <line x1="225" y1="0" x2="225" y2="240" />
  </g>

  <!-- Ambient Light Circle -->
  <circle cx="150" cy="110" r="60" fill="#2dd4bf" opacity="0.18" filter="url(#glow_44)" />

  <!-- Badge / Brand Tag -->
  <g transform="translate(16, 16)">
    <rect width="151.0" height="22" rx="11" fill="#ffffff" fill-opacity="0.15" />
    <text x="75.5" y="15" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.03em">Women's Waterproof</text>
  </g>

  <!-- Category Pill -->
  <g transform="translate(284, 16)">
    <text x="0" y="15" fill="#2dd4bf" font-family="ui-monospace, monospace" font-size="9" font-weight="600" text-anchor="end" text-transform="uppercase" letter-spacing="0.05em">outerwear</text>
  </g>

  <!-- Product Artwork Graphic -->
  
        <!-- Jacket / Outerwear Graphic -->
        <g transform="translate(65, 40) scale(1.1)">
            <path d="M50 25 L85 38 L120 25 L150 50 L135 85 L120 75 L120 145 L50 145 L50 75 L35 85 L20 50 Z" fill="#2dd4bf" fill-opacity="0.3"/>
            <path d="M54 30 L85 42 L116 30 L142 52 L130 80 L116 72 L116 140 L54 140 L54 72 L40 80 L28 52 Z" fill="#2dd4bf"/>
            <line x1="85" y1="42" x2="85" y2="140" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
            <path d="M72 30 Q85 45 98 30" fill="none" stroke="#ffffff" stroke-width="2.5"/>
            <line x1="60" y1="85" x2="75" y2="95" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
            <line x1="110" y1="85" x2="95" y2="95" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
        </g>
        

  <!-- Bottom Accent Line -->
  <rect x="20" y="226" width="260" height="2" rx="1" fill="#2dd4bf" fill-opacity="0.4" />
</svg>
