RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace-with-the-webhook-secret-from-the-razorpay-dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCHANT_SESSION_SECRET=replace-with-a-long-random-string
# Comma-separated allowed frontend origin(s) for CORS (server/app.py and
# mcp_server/server.py both read this). Defaults to the local dev origins
# below if unset, so this is only required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "production" on deployed services (e.g. Render) only. Switches the
# merchant session cookie to SameSite=None; Secure=True, required for the
# cookie to survive the cross-site call from the Vercel frontend to this
# API. Leave unset for local dev — SameSite=None; Secure=True cookies are
# not sent over plain http://localhost. See mcp_server/server.py's
# IS_PRODUCTION and DEPLOY.md.
ENVIRONMENT=development
